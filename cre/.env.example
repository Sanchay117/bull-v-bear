# Copy to cre/.env (git-ignored).

# Funded Sepolia key, only needed for `cre workflow simulate --broadcast`.
CRE_ETH_PRIVATE_KEY=

# Key for the workflow's LLM, read through runtime.getSecret("LLM_API_KEY"):
# an Anthropic key when config "provider" is "anthropic", otherwise the OpenAI-compatible provider's key.
LLM_API_KEY_ENV=
