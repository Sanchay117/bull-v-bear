# Copy to server/.env (git-ignored). Everything is optional.

# Claude counsel. Without a key the court runs deterministic demo counsel.
ANTHROPIC_API_KEY=
# COUNSEL=auto            # auto | claude | demo
# CLAUDE_MODEL=claude-opus-5-5

# Where the record is kept.
# CHAIN_MODE=local        # local (anvil, auto-deploys CourtRecord) | sepolia | off
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# COURT_ADDRESS=0x...     # required for sepolia: the CourtRecord the CRE workflow files into

# Optional shared secret the CRE workflow must send as x-court-key when lodging transcripts.
# RECORDS_KEY=
