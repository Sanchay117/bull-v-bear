# Copy to server/.env (git-ignored). Everything is optional.

# Live counsel: the first one configured wins (COUNSEL=claude|llm|demo forces one).
# 1. Claude
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# 2. Any OpenAI-compatible chat completions API (example models; check the provider's current list)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1                         LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://openrouter.ai/api/v1                        LLM_MODEL=<any id ending in :free>
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemma-4-31b-it
#   (Gemini free tier: Gemini models allow ~20 requests/day each and a trial uses 5; Gemma's quota is separate.)
# LLM_BASE_URL=https://api.groq.com/openai/v1                      LLM_MODEL=openai/gpt-oss-120b

# 3. Neither: deterministic demo counsel.

# Market data. CoinGecko limits keyless calls per IP; on a shared host (Render, Railway) add a free
# Demo API key from coingecko.com/en/api so discovery gets its own quota.
# COINGECKO_API_KEY=

# Where the record is kept.
# CHAIN_MODE=local        # local (anvil, auto-deploys CourtRecord) | sepolia | off
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# COURT_ADDRESS=0x...     # required for sepolia: the CourtRecord the CRE workflow files into

# Optional shared secret the CRE workflow must send as x-court-key when lodging transcripts.
# RECORDS_KEY=
